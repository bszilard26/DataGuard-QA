# ========================================
# 📦 PYTHON BUILD ARTIFACTS
# ========================================
__pycache__/
*.py[cod]       # bytecode files
*$py.class

# ========================================
# 🧪 TESTING & COVERAGE
# ========================================
.pytest_cache/           # pytest run cache
.cache/                  # generic cache
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.coverage               # coverage file
coverage.xml
htmlcov/                 # HTML coverage reports

# ========================================
# 📁 VIRTUAL ENVIRONMENTS
# ========================================
venv/                    # local virtualenv
.venv/                   # alternate venv name
.env                     # env config (optional)
.env.*                   # any other .env config

# ========================================
# ⚙️ EDITORS & IDEs
# ========================================
.vscode/                 # VS Code settings
.idea/                   # JetBrains IDE settings
.DS_Store                # macOS Finder metadata

# ========================================
# 🐋 DOCKER
# ========================================
*.log                    # docker logs
*.pid                    # process id files

# ========================================
# 🧾 REPORTING (ALLURE)
# ========================================
reports/allure-results/  # allure results dir
reports/allure-report/   # allure generated html
reports/tmp/

# ========================================
# 🗃️ DATABASE FILES
# ========================================
*.db                     # SQLite DBs (ex: etl_sample.db)
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
customers_medium.csv

# ========================================
# 🥚 PYTHON PACKAGING
# ========================================
*.egg-info/
.eggs/

# ========================================
# 🧪 TEMPORARY / LOCAL TEST ARTIFACTS
# ========================================
*.tmp
*.bak
*.old
